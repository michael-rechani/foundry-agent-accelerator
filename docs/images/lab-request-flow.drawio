<mxfile host="app.diagrams.net" type="device">
  <diagram id="lab-request-flow" name="Chat request and delegation">
    <mxGraphModel dx="1200" dy="1200" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1200" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="Chat | Request, delegation, and explicit save" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=28;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1120" height="44" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Deployed Lab request path through named Foundry endpoints; APIM is not in this path" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=16;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1120" height="28" as="geometry" /></mxCell>
        <mxCell id="scope" value="READ TOP TO BOTTOM  |  Solid blue = request   |   Dashed blue = response   |   Green = explicit persistence" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;spacingLeft=14;fillColor=#EAF3FE;strokeColor=#BED6F0;fontFamily=Segoe UI;fontSize=14;fontColor=#164B80;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="1120" height="38" as="geometry" /></mxCell>
        <mxCell id="users-icon" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="132" y="182" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="identity-icon" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="347" y="181" width="32" height="32" as="geometry" /></mxCell>
        <mxCell id="identity-label" value="Managed-identity Azure calls" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=13;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="390" y="184" width="194" height="28" as="geometry" /></mxCell>
        <mxCell id="foundry-icon" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="708" y="180" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="foundry-label" value="Foundry Agent Service | custom hosted agents" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=15;fontColor=#164B80;" vertex="1" parent="1"><mxGeometry x="755" y="180" width="398" height="36" as="geometry" /></mxCell>
        <mxCell id="browser" value="Browser&#xa;The Lab (React)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#F3F5F8;strokeColor=#BCCBDB;fontFamily=Segoe UI;fontSize=17;fontColor=#24364B;" vertex="1" parent="1"><mxGeometry x="40" y="234" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="api" value="FastAPI&#xa;FoundryGateway" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#EAF3FE;strokeColor=#9DBDE2;fontFamily=Segoe UI;fontSize=17;fontColor=#164B80;" vertex="1" parent="1"><mxGeometry x="340" y="234" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="coordinator" value="Coordinator&#xa;Profile-defined tools" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#EAF3FE;strokeColor=#9DBDE2;fontFamily=Segoe UI;fontSize=17;fontColor=#164B80;" vertex="1" parent="1"><mxGeometry x="640" y="234" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="specialist" value="Specialist&#xa;Application or case" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#EAF3FE;strokeColor=#9DBDE2;fontFamily=Segoe UI;fontSize=17;fontColor=#164B80;" vertex="1" parent="1"><mxGeometry x="940" y="234" width="220" height="70" as="geometry" /></mxCell>
        <mxCell id="lane-browser" style="endArrow=none;dashed=1;strokeColor=#BCCBDB;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="304" as="sourcePoint" /><mxPoint x="150" y="886" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lane-api" style="endArrow=none;dashed=1;strokeColor=#BCCBDB;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450" y="304" as="sourcePoint" /><mxPoint x="450" y="886" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lane-coordinator" style="endArrow=none;dashed=1;strokeColor=#BCCBDB;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="750" y="304" as="sourcePoint" /><mxPoint x="750" y="886" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="lane-specialist" style="endArrow=none;dashed=1;strokeColor=#BCCBDB;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1050" y="304" as="sourcePoint" /><mxPoint x="1050" y="886" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="message-1" value="1  POST /api/reviews&#xa;Message + bounded history" style="endArrow=block;endFill=1;strokeColor=#0F6CBD;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontColor=#164B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" y="24" as="geometry"><mxPoint x="150" y="368" as="sourcePoint" /><mxPoint x="450" y="368" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="guards" value="Origin, input and catalog checks&#xa;Admission before agent execution" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#F4F7FB;strokeColor=#D6DFEB;fontFamily=Segoe UI;fontSize=14;fontColor=#34465D;" vertex="1" parent="1"><mxGeometry x="323" y="393" width="254" height="56" as="geometry" /></mxCell>
        <mxCell id="message-2" value="2  Responses API&#xa;Managed identity, store=false" style="endArrow=block;endFill=1;strokeColor=#0F6CBD;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontColor=#164B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" y="24" as="geometry"><mxPoint x="450" y="506" as="sourcePoint" /><mxPoint x="750" y="506" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="message-3" value="3  If a specialist tool is selected&#xa;Full supplied request, named target" style="endArrow=block;endFill=1;strokeColor=#0F6CBD;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontColor=#164B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" y="24" as="geometry"><mxPoint x="750" y="586" as="sourcePoint" /><mxPoint x="1050" y="586" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="message-4" value="4  Completed, nonempty output&#xa;Tool result names the invoked agent" style="endArrow=open;dashed=1;strokeColor=#0F6CBD;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontColor=#164B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" y="-24" as="geometry"><mxPoint x="1050" y="666" as="sourcePoint" /><mxPoint x="750" y="666" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="message-5" value="5  Final answer + tool outputs&#xa;Call IDs allow receipt correlation" style="endArrow=open;dashed=1;strokeColor=#0F6CBD;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontColor=#164B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" y="-24" as="geometry"><mxPoint x="750" y="746" as="sourcePoint" /><mxPoint x="450" y="746" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="receipt-check" value="Bound response size&#xa;Compute receipt verification flags" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#F4F7FB;strokeColor=#D6DFEB;fontFamily=Segoe UI;fontSize=14;fontColor=#34465D;" vertex="1" parent="1"><mxGeometry x="323" y="770" width="254" height="54" as="geometry" /></mxCell>
        <mxCell id="message-6" value="6  Answer + receipt status&#xa;No implicit Cosmos write" style="endArrow=open;dashed=1;strokeColor=#0F6CBD;strokeWidth=2;fontFamily=Segoe UI;fontSize=14;fontColor=#164B80;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" y="-24" as="geometry"><mxPoint x="450" y="880" as="sourcePoint" /><mxPoint x="150" y="880" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="policy-note" value="Chat may return clarification without delegation.&#xa;It reports receipt status, not a strict citation verdict.&#xa;&#xa;Document reviews add fail-closed receipt and&#xa;exact-quote validation before saving findings." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;spacing=16;fillColor=#FFF7E6;strokeColor=#E8C779;fontFamily=Segoe UI;fontSize=14;fontColor=#775414;" vertex="1" parent="1"><mxGeometry x="795" y="746" width="365" height="142" as="geometry" /></mxCell>
        <mxCell id="save-boundary" value="PERSISTENCE IS A SEPARATE USER ACTION" style="swimlane;html=0;startSize=36;rounded=1;arcSize=8;fillColor=#E5F3EE;swimlaneFillColor=#F7FCFA;strokeColor=#A6CEBC;fontFamily=Segoe UI;fontSize=14;fontStyle=1;fontColor=#245C48;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="1120" height="172" as="geometry" /></mxCell>
        <mxCell id="save-user" value="7  Save to shared history&#xa;Completed exchanges" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A6CEBC;fontFamily=Segoe UI;fontSize=16;fontColor=#245C48;" vertex="1" parent="1"><mxGeometry x="60" y="990" width="220" height="84" as="geometry" /></mxCell>
        <mxCell id="save-api" value="History API&#xa;/api/conversations&#xa;Create or conditional update" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#A6CEBC;fontFamily=Segoe UI;fontSize=15;fontColor=#245C48;" vertex="1" parent="1"><mxGeometry x="380" y="990" width="260" height="84" as="geometry" /></mxCell>
        <mxCell id="cosmos-icon" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="825" y="1010" width="42" height="42" as="geometry" /></mxCell>
        <mxCell id="cosmos-label" value="Cosmos shared history&#xa;Stored receipts are unverified&#xa;30-day TTL since last write" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=15;fontColor=#245C48;" vertex="1" parent="1"><mxGeometry x="883" y="994" width="258" height="78" as="geometry" /></mxCell>
        <mxCell id="save-edge" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#24815C;strokeWidth=2;" edge="1" parent="1" source="save-user" target="save-api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="save-cosmos" value="Managed identity" style="endArrow=block;endFill=1;strokeColor=#24815C;strokeWidth=2;fontFamily=Segoe UI;fontSize=13;fontColor=#245C48;labelBackgroundColor=#F7FCFA;" edge="1" parent="1"><mxGeometry relative="1" y="-18" as="geometry"><mxPoint x="640" y="1032" as="sourcePoint" /><mxPoint x="805" y="1032" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="footer" value="Lab: 4 in-flight agent calls, 20/minute, up to 180 seconds. Specialist default: 4 slots, 90 seconds.&#xa;Local timeout or browser cancellation does not guarantee remote work stops. No automatic model retry." style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=14;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="40" y="1124" width="1120" height="54" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
