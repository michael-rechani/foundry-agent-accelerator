<mxfile host="app.diagrams.net" type="device">
  <diagram id="review-lifecycle" name="Persisted review lifecycle">
    <mxGraphModel dx="1200" dy="1280" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="1280" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />
        <mxCell id="title" value="Document reviews | Persistence and recovery" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=28;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="40" y="28" width="1120" height="44" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="A bounded application workflow over the existing coordinator, not a durable worker or model session" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=16;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1120" height="28" as="geometry" /></mxCell>
        <mxCell id="scope" value="DOCUMENT REVIEWS PAGE  |  Conditional starts, input snapshots, and explicit resume" style="rounded=1;arcSize=10;whiteSpace=wrap;html=0;align=left;spacingLeft=14;fillColor=#FFF7E6;strokeColor=#E8C779;fontFamily=Segoe UI;fontSize=14;fontColor=#775414;" vertex="1" parent="1"><mxGeometry x="40" y="118" width="1120" height="38" as="geometry" /></mxCell>
        <mxCell id="phase-one" value="A  ACCEPT AND PERSIST BEFORE EXECUTION" style="swimlane;html=0;startSize=40;rounded=1;arcSize=8;fillColor=#E7F1FC;swimlaneFillColor=#FAFCFF;strokeColor=#AFCBEA;fontFamily=Segoe UI;fontSize=14;fontStyle=1;fontColor=#164B80;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1120" height="236" as="geometry" /></mxCell>
        <mxCell id="create" value="1  Create draft&#xa;&#xa;POST /api/review-runs&#xa;Validate criteria and sources&#xa;Server-owned fields + ETag" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#9DBDE2;fontFamily=Segoe UI;fontSize=15;fontColor=#24364B;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="252" width="235" height="118" as="geometry" /></mxCell>
        <mxCell id="start" value="2  Explicit Run&#xa;&#xa;POST /execute + If-Match&#xa;Require draft and run budget&#xa;Acquire shared agent slot" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#9DBDE2;fontFamily=Segoe UI;fontSize=15;fontColor=#24364B;spacing=10;" vertex="1" parent="1"><mxGeometry x="340" y="252" width="235" height="118" as="geometry" /></mxCell>
        <mxCell id="persist" value="3  Persist running&#xa;&#xa;Conditional Cosmos write&#xa;Snapshot the input&#xa;Save ETag + recovery window" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#EAF7F1;strokeColor=#A6CEBC;fontFamily=Segoe UI;fontSize=15;fontColor=#245C48;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="252" width="235" height="118" as="geometry" /></mxCell>
        <mxCell id="task" value="4  Schedule task&#xa;&#xa;Local asyncio execution&#xa;Return HTTP 202&#xa;Browser polls the record" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#9DBDE2;fontFamily=Segoe UI;fontSize=15;fontColor=#24364B;spacing=10;" vertex="1" parent="1"><mxGeometry x="900" y="252" width="240" height="118" as="geometry" /></mxCell>
        <mxCell id="phase-one-note" value="Create does not call the model. Competing starts fail with 409. Browser disconnect does not stop the accepted task." style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=14;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="60" y="384" width="1080" height="28" as="geometry" /></mxCell>
        <mxCell id="create-start" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#0F6CBD;strokeWidth=2;" edge="1" parent="1" source="create" target="start"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="start-persist" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#0F6CBD;strokeWidth=2;" edge="1" parent="1" source="start" target="persist"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="persist-task" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#24815C;strokeWidth=2;" edge="1" parent="1" source="persist" target="task"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="phase-two" value="B  EXECUTE, VALIDATE, THEN SAVE  |  FOLLOW THE RETURN PATH RIGHT TO LEFT" style="swimlane;html=0;startSize=40;rounded=1;arcSize=8;fillColor=#E7F1FC;swimlaneFillColor=#FAFCFF;strokeColor=#AFCBEA;fontFamily=Segoe UI;fontSize=14;fontStyle=1;fontColor=#164B80;align=left;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="40" y="474" width="1120" height="234" as="geometry" /></mxCell>
        <mxCell id="save" value="7  Conditional final write&#xa;&#xa;Findings or failure code&#xa;Observed events and elapsed time&#xa;Use the execution ETag" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#EAF7F1;strokeColor=#A6CEBC;fontFamily=Segoe UI;fontSize=15;fontColor=#245C48;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="535" width="305" height="116" as="geometry" /></mxCell>
        <mxCell id="validation" value="6  Fail-closed checks&#xa;&#xa;Required verified specialist receipts&#xa;JSON and complete criterion coverage&#xa;Exact quotes from named sources" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#9DBDE2;fontFamily=Segoe UI;fontSize=15;fontColor=#24364B;spacing=10;" vertex="1" parent="1"><mxGeometry x="430" y="535" width="350" height="116" as="geometry" /></mxCell>
        <mxCell id="foundry" value="5  Foundry Agent Service&#xa;&#xa;Existing coordinator and specialists&#xa;Schema + accumulated evidence&#xa;Response text and tool outputs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#9DBDE2;fontFamily=Segoe UI;fontSize=15;fontColor=#24364B;spacing=10;" vertex="1" parent="1"><mxGeometry x="845" y="535" width="295" height="116" as="geometry" /></mxCell>
        <mxCell id="task-foundry" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#0F6CBD;strokeWidth=2;exitX=1;exitY=0.7;entryX=1;entryY=0.5;" edge="1" parent="1" source="task" target="foundry"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1180" y="335" /><mxPoint x="1180" y="593" /></Array></mxGeometry></mxCell>
        <mxCell id="foundry-validation" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#0F6CBD;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="foundry" target="validation"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="validation-save" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#24815C;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="validation" target="save"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="cosmos-icon" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="63" y="668" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="cosmos-note" value="Cosmos record owns state and snapshots" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=13;fontColor=#245C48;" vertex="1" parent="1"><mxGeometry x="102" y="666" width="324" height="30" as="geometry" /></mxCell>
        <mxCell id="agent-icon" value="" style="shape=image;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" vertex="1" parent="1"><mxGeometry x="845" y="668" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="agent-note" value="Managed identity, up to 180 seconds" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=13;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="882" y="666" width="265" height="30" as="geometry" /></mxCell>
        <mxCell id="outcome-heading" value="C  EFFECTIVE OUTCOME IN INBOX AND DETAIL" style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=15;fontStyle=1;fontColor=#34465D;" vertex="1" parent="1"><mxGeometry x="40" y="744" width="1120" height="30" as="geometry" /></mxCell>
        <mxCell id="completed" value="COMPLETED&#xa;&#xa;Valid findings, no questions&#xa;Final write confirmed&#xa;Read and export" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#EAF7F1;strokeColor=#A6CEBC;fontFamily=Segoe UI;fontSize=15;fontColor=#245C48;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="806" width="260" height="146" as="geometry" /></mxCell>
        <mxCell id="waiting" value="WAITING_INPUT&#xa;&#xa;Valid result asks questions&#xa;Final write confirmed&#xa;More evidence may be added" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FFF7E6;strokeColor=#E8C779;fontFamily=Segoe UI;fontSize=15;fontColor=#775414;spacing=12;" vertex="1" parent="1"><mxGeometry x="330" y="806" width="260" height="146" as="geometry" /></mxCell>
        <mxCell id="failed" value="FAILED&#xa;&#xa;Timeout or rejected result&#xa;Failure write confirmed&#xa;No automatic retry" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FDF0EF;strokeColor=#DFB5AF;fontFamily=Segoe UI;fontSize=15;fontColor=#8B3D35;spacing=12;" vertex="1" parent="1"><mxGeometry x="620" y="806" width="260" height="146" as="geometry" /></mxCell>
        <mxCell id="interrupted" value="INTERRUPTED&#xa;&#xa;Stopped or window expired&#xa;Stored status may be running&#xa;Explicit recovery available" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#FDF0EF;strokeColor=#DFB5AF;fontFamily=Segoe UI;fontSize=15;fontColor=#8B3D35;spacing=12;" vertex="1" parent="1"><mxGeometry x="910" y="806" width="250" height="146" as="geometry" /></mxCell>
        <mxCell id="read-note" value="GET reads never start an agent. A failed browser poll can be restarted with Refresh, without resubmitting execution." style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=14;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="40" y="1154" width="1120" height="30" as="geometry" /></mxCell>
        <mxCell id="resume" value="CLARIFICATION / RESUME&#xa;Append evidence with If-Match -> new draft -> explicit Run (step 2).&#xa;Prior run inputs stay unchanged. Resume makes a new call over accumulated evidence." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;align=left;spacing=16;fillColor=#FFF7E6;strokeColor=#E8C779;fontFamily=Segoe UI;fontSize=15;fontColor=#775414;" vertex="1" parent="1"><mxGeometry x="330" y="1030" width="830" height="108" as="geometry" /></mxCell>
        <mxCell id="waiting-resume" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeColor=#B38225;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.16;entryY=0;" edge="1" parent="1" source="waiting" target="resume"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="limits" value="AT MOST FOUR RUNS&#xa;Evidence append also requires&#xa;room in source and content limits." style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=14;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="270" height="82" as="geometry" /></mxCell>
        <mxCell id="footer" value="Process-local execution only: one worker / replica. No durable queue, automatic retry, or immutable audit ledger.&#xa;Remote work may finish after cancellation. Recover interrupted runs explicitly; new calls may incur another charge." style="text;html=0;align=left;fontFamily=Segoe UI;fontSize=14;fontColor=#526176;" vertex="1" parent="1"><mxGeometry x="40" y="1205" width="1120" height="54" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>