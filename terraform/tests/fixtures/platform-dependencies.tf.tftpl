# Superseded: test-platform-validation.ps1 no longer copies this fragment. It now tests the real
# main.tf, network.tf, apim.tf and review-api.tf, with the module stubs in ./foundry and ./api-management.
# Kept only because terraform/README.md still links it; delete it when that README section is updated.
# This fragment is not a standalone Terraform module.
locals {
  private_dns_zones      = { storage_blob = "privatelink.blob.core.windows.net" }
  jumpbox_admin_password = "synthetic-offline-fixture-only"
}

data "azurerm_client_config" "current" {}

module "ai_foundry" {
  source = "./tests/fixtures/foundry"
}

module "api_management" {
  count  = var.enable_api_management ? 1 : 0
  source = "./tests/fixtures/api-management"
}

resource "azurerm_resource_group" "this" {
  name     = "rg-platform-test-12345"
  location = local.deployment_location
}

resource "azurerm_virtual_network" "this" {
  name                = "vnet-platform-test"
  location            = local.deployment_location
  resource_group_name = azurerm_resource_group.this.name
  address_space       = ["10.0.0.0/16"]
}

resource "azurerm_subnet" "private_endpoints" {
  name                 = "private-endpoints"
  resource_group_name  = azurerm_resource_group.this.name
  virtual_network_name = azurerm_virtual_network.this.name
  address_prefixes     = ["10.0.0.0/24"]
}

resource "azurerm_private_dns_zone" "this" {
  for_each            = { storage_blob = "privatelink.blob.core.windows.net" }
  name                = each.value
  resource_group_name = azurerm_resource_group.this.name
}
