resource_group_name  = "rg-example"
virtual_network_name = "vnet-jumpbox-example"
nat_gateway_name     = "nat-jumpbox-example"
# A public SSH key only. Azure requires one; the VM has no inbound path to use it.
admin_ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAINscr5/0uytwl6kAEaWqSaYio1YQpVWBT/G7ui/VusPg runner-test"
