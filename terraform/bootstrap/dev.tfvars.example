subscription_id = "00000000-0000-0000-0000-000000000000"
location        = "northcentralus"

# Existing host VNets get two-way peering and a shared blob DNS link.
# The runner is in the management VNet: add that VNet only once.
# First migrate any existing platform-owned blob zone links (README.md).
# Do not add the workload VNet: the platform owns its shared-zone link.
# peered_virtual_network_ids = {
#   management = "/subscriptions/<id>/resourceGroups/<rg>/providers/Microsoft.Network/virtualNetworks/<vnet>"
# }

# Extra identities (CI runner managed identity, teammates) that need state access.
# state_contributor_object_ids = {
#   runner = "00000000-0000-0000-0000-000000000000"
# }
