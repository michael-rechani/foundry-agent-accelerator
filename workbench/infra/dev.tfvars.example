subscription_id      = "00000000-0000-0000-0000-000000000000"
resource_group_name  = "existing-resource-group"
workload_vnet_name   = "existing-workload-vnet"
management_vnet_name = "existing-management-vnet"
foundry_account_name = "existing-foundry-account"
foundry_project_name = "existing-foundry-project"
cosmos_account_name  = "existing-cosmos-account"
registry_name        = "globallyuniqueregistryname"
workspace_title      = "Foundry Agent Lab"
visible_agents       = ["customer-review"]
default_agent        = "customer-review"

# Optional: create a Terraform-owned email action group for operational alerts.
# Keep real recipients in ignored deployment inputs, not this example.
# managed_alert_email_receivers = {
#   operations = "operations@example.invalid"
# }

# Optional: the published requests and tokens per minute of each model deployment the Lab's chat can reach.
# The Lab answers busy before a turn would pass a deployment's limit. The defaults are the dev tenant's limits;
# set your own, with some headroom, or use {} to turn this off. This sets no Foundry quota.
# model_limits = {
#   "gpt-5.4" = { requests_per_minute = 100, tokens_per_minute = 10000 }
# }

# Optional: Azure Front Door Premium in front of the Lab, limited to your own public IP. Off by default, public, and
# billed per profile (see docs/lab-configuration-and-cost.md). Keep your real address in ignored deployment inputs.
# enable_front_door                = true
# approve_public_front_door        = true
# front_door_allowed_cidrs         = ["203.0.113.10/32"]
# front_door_private_link_location = "centralus"
# Required with Front Door: Private Link traffic reaches the app from this shared range, so without it the origin
# health probe is refused and Front Door reports 0% origin health (see docs/ingress-access.md).
# front_door_ingress_allow_cidrs   = ["100.64.0.0/10"]
