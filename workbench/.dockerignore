*
!Dockerfile
!requirements.txt
# Every top-level Python module ships, so a new module needs no edit here, in the
# Dockerfile, build.ps1, test-build.ps1 or the CI compile step. Add a pattern
# below only to keep a file out of the image.
!*.py
test_*.py
verify_private.py
# Data files are listed individually.
!agents.json
!agent_scorecards.json
!agent_runtime/
agent_runtime/*
!agent_runtime/main.py
!agent_runtime/demo_tools.py
!agent_runtime/bill_math.py
!agent_runtime/requirements.txt
# The agent code the designer's hosted-agent bundle carries, a copy of hosted-agents/basic-responses-agent.
!basic_agent_source/
basic_agent_source/*
!basic_agent_source/main.py
!basic_agent_source/requirements.txt
!basic_agent_source/instructions.md
# Packages ship by directory: add one here and in the Dockerfile and build.ps1.
# agent_templates/agents/ holds one JSON file per library agent, so a new agent needs no edit here.
!agent_templates/
agent_templates/*
!agent_templates/*.py
!agent_templates/agents/
agent_templates/agents/*
!agent_templates/agents/*.json
!frontend/
!frontend/**
frontend/node_modules/
frontend/dist/
frontend/.git/
frontend/.env*
frontend/*.log